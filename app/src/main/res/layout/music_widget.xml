<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="10dp">

    <!-- 第一行：封面 + 歌曲信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_widget_default_album"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_song_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未在播放"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>


    <!-- 第二行：进度条 -->
    <LinearLayout
        android:id="@+id/widget_progress_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:orientation="horizontal"
        android:gravity="center_vertical">


        <TextView
            android:id="@+id/widget_time_current"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />


        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:max="100"
            android:progress="0" />


        <TextView
            android:id="@+id/widget_time_total"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>


    <!-- 第三行：五个控制按钮 -->
    <LinearLayout
        android:id="@+id/widget_control_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:gravity="center">


        <!-- 快退10秒 -->
        <ImageView
            android:id="@+id/widget_btn_rewind"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_rewind"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:padding="8dp" />


        <!-- 上一首 -->
        <ImageView
            android:id="@+id/widget_btn_previous"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_previous"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:padding="8dp" />


        <!-- 播放暂停 -->
        <ImageView
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_play"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:padding="4dp" />


        <!-- 下一首 -->
        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_next"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:padding="8dp" />


        <!-- 快进10秒 -->
        <ImageView
            android:id="@+id/widget_btn_forward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_forward"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:padding="8dp" />


    </LinearLayout>

</LinearLayout>