<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="10dp">

    <!-- 第一行：封面 + 歌曲信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_widget_default_album"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/widget_song_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未在播放"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第二行：进度条 + 时间 + 快进/快退 -->
    <LinearLayout
        android:id="@+id/widget_progress_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_time_current"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />

        <!-- 快退 10s -->
        <ImageView
            android:id="@+id/widget_btn_rewind"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_widget_previous"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="4dp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:max="100"
            android:progress="0" />

        <!-- 快进 10s -->
        <ImageView
            android:id="@+id/widget_btn_forward"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_widget_next"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="4dp" />

        <TextView
            android:id="@+id/widget_time_total"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 第三行：控制按钮（均匀分布） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/widget_btn_previous"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_previous"
            android:background="@android:color/transparent"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_play"
            android:background="@android:color/transparent"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_next"
            android:background="@android:color/transparent"
            android:scaleType="centerInside" />
    </LinearLayout>

</LinearLayout>
